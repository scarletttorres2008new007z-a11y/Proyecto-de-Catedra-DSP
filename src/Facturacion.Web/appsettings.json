{
  "ConnectionStrings": {
    "Facturacion": "Server=localhost;Database=FacturacionDSP;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "BaseDatos": {
    "Proveedor": "SqlServer",
    "MigrarAlIniciar": false
  },
  "Facturacion": {
    "Modo": "Academico",
    "UmbralIdentificacionFactura": 25000
  },
  "Anulaciones": {
    "Factura": { "Valor": 3, "Unidad": "Meses" },
    "CreditoFiscal": { "Valor": 1, "Unidad": "Dias" },
    "NotaCredito": { "Valor": 1, "Unidad": "Dias" }
  },
  "Almacenamiento": {
    "RutaDocumentos": "App_Data/Documentos"
  },
  "Smtp": {
    "Servidor": "",
    "Puerto": 587,
    "Seguridad": "StartTls",
    "Usuario": "",
    "Contrasena": "",
    "RemitenteCorreo": "",
    "RemitenteNombre": "Facturación DSP",
    "TiempoEsperaSegundos": 30
  },
  "Respaldos": {
    "Directorio": "",
    "TiempoEsperaSegundos": 600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
