@model Cliente
@inject Facturacion.Application.Abstracciones.IReloj Reloj
@{
    ViewData["Title"] = Model.Nombre;
    var historial = (List<DocumentoTributario>)ViewData["Historial"]!;
}
<div class="encabezado-pagina">
    <div>
        <h1>@Model.Nombre</h1>
        <p class="subtitulo">@Presentacion.TipoCliente(Model.Tipo) · @Presentacion.Activo(Model.Activo)</p>
    </div>
    <div class="acciones">
        @if (Model.Activo)
        {
            <a class="boton" asp-controller="Documentos" asp-action="Emitir" asp-route-tipo="FacturaConsumidorFinal" asp-route-clienteId="@Model.Id">Emitir factura</a>
            @if (Model.Tipo == TipoCliente.Contribuyente)
            {
                <a class="boton" asp-controller="Documentos" asp-action="Emitir" asp-route-tipo="ComprobanteCreditoFiscal" asp-route-clienteId="@Model.Id">Emitir CCF</a>
            }
        }
        <a class="boton boton-secundario" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
        <form method="post" asp-action="CambiarEstado" asp-route-id="@Model.Id" class="en-linea"
              data-confirmar="@(Model.Activo ? "¿Desactivar este cliente? No podrá seleccionarse en nuevas emisiones." : "¿Activar este cliente?")">
            <input type="hidden" name="activo" value="@(!Model.Activo ? "true" : "false")" />
            <button type="submit" class="boton boton-secundario">@(Model.Activo ? "Desactivar" : "Activar")</button>
        </form>
    </div>
</div>

<div class="rejilla rejilla-2">
    <section class="tarjeta">
        <h2>Datos</h2>
        <dl class="datos">
            <dt>Nombre comercial</dt><dd>@(Model.NombreComercial ?? "—")</dd>
            <dt>Documento</dt><dd>@(Model.NumeroDocumento is null ? "—" : $"{Catalogos.NombreTipoDocumento(Model.TipoDocumento)} {Model.NumeroDocumento}")</dd>
            <dt>NRC</dt><dd>@(Model.Nrc ?? "—")</dd>
            <dt>Actividad económica</dt><dd>@(Model.CodActividad is null ? "—" : $"{Model.CodActividad} - {Model.DescActividad}")</dd>
        </dl>
    </section>
    <section class="tarjeta">
        <h2>Contacto</h2>
        <dl class="datos">
            <dt>Dirección</dt><dd>@(Model.Complemento is null ? "—" : $"{Model.Complemento}, {Catalogos.NombreDepartamento(Model.Departamento)} (municipio {Model.Municipio})")</dd>
            <dt>Teléfono</dt><dd>@(Model.Telefono ?? "—")</dd>
            <dt>Correo</dt><dd>@(Model.Correo ?? "Sin correo: los documentos no podrán enviarse automáticamente")</dd>
            <dt>Registrado</dt><dd>@Presentacion.FechaHoraLocal(Model.CreadoUtc, Reloj)</dd>
        </dl>
    </section>
</div>

<section class="tarjeta">
    <h2>Historial de documentos</h2>
    @if (historial.Count == 0)
    {
        <p class="vacio">Este cliente aún no tiene documentos.</p>
    }
    else
    {
        <div class="tabla-contenedor">
            <table class="tabla">
                <thead><tr><th>Fecha</th><th>Tipo</th><th>Número de control</th><th class="derecha">Total</th><th>Estado</th></tr></thead>
                <tbody>
                @foreach (var d in historial)
                {
                    <tr>
                        <td class="nowrap">@Presentacion.Fecha(d.FechaEmision)</td>
                        <td>@TiposDteInfo.NombreCorto(d.Tipo)</td>
                        <td><a class="monoespaciado" asp-controller="Documentos" asp-action="Detalle" asp-route-id="@d.Id">@d.NumeroControl</a></td>
                        <td class="derecha">@Presentacion.Moneda(d.TotalPagar)</td>
                        <td>@Presentacion.EstadoDocumento(d.Estado, d.Modo)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
